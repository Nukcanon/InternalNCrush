class_name HeroWeapon
extends RefCounted
## Chunky, toy-like but detailed weapons (muzzle toward -Z, grip at origin).
## Built from cached primitives and merged into a single cel-shaded mesh.
const S=preload("res://scripts/style/hero_style.gd")
const BODY=Color("d9dde5")
const DARK=Color("2b3142")
const MID=Color("566074")
const METAL=Color("8a93a3")
const GLOW=Color("4fe0d0")
const Z=Vector3(PI/2,0,0)
static func build(kind:String,accent:Color=Color("e2772a")) -> Node3D:
	var root=Node3D.new();root.name="HeroWeapon_"+kind
	match kind:
		"rifle":rifle(root,accent)
		"shotgun":shotgun(root,accent)
		"sniper":sniper(root,accent)
		"pistol":pistol(root,accent)
		"launcher":launcher(root,accent)
	S.finish(root,false,.55)
	return root
static func grip(root:Node3D,pos:Vector3,color:Color=DARK):
	S.rbox(root,pos,Vector3(.048,.13,.07),color,Vector3(.32,0,0),.6)
	for i in range(3):S.rbox(root,pos+Vector3(0,.035-i*.035,.036+i*.011),Vector3(.05,.008,.012),MID,Vector3(.32,0,0),.9)
	S.rbox(root,pos+Vector3(0,.065,-.055),Vector3(.01,.012,.07),DARK,Vector3.ZERO,.9)
	S.rbox(root,pos+Vector3(0,.035,-.09),Vector3(.01,.05,.01),DARK,Vector3(-.2,0,0),.9)
static func rail(root:Node3D,pos:Vector3,length:float):
	S.rbox(root,pos,Vector3(.03,.018,length),DARK,Vector3.ZERO,.5)
	var n=int(length/.028)
	for i in range(n):S.rbox(root,pos+Vector3(0,.013,-length*.5+.014+i*.028),Vector3(.034,.01,.012),MID,Vector3.ZERO,.6)
static func vents(root:Node3D,pos:Vector3,count:int,step:float,side:float):
	for i in range(count):S.rbox(root,pos+Vector3(side,0,-i*step),Vector3(.006,.022,.03),DARK,Vector3.ZERO,.9)
static func optic(root:Node3D,pos:Vector3,length:float,radius:float,accent:Color):
	S.cyl(root,pos,radius,length,DARK,Z)
	S.cyl(root,pos+Vector3(0,0,-length*.5),radius*1.25,.03,accent,Z)
	S.cyl(root,pos+Vector3(0,0,-length*.5-.016),radius*.95,.004,GLOW,Z)
	S.cyl(root,pos+Vector3(0,0,length*.5),radius*1.15,.025,MID,Z)
	S.rbox(root,pos+Vector3(0,-radius-.012,0),Vector3(.03,.02,length*.5),MID,Vector3.ZERO,.6)
	S.cyl(root,pos+Vector3(radius+.008,0,0),.012,.02,MID,Vector3(0,0,PI/2))
static func rifle(root:Node3D,accent:Color):
	S.rbox(root,Vector3(0,.035,-.14),Vector3(.085,.115,.3),BODY)
	S.rbox(root,Vector3(0,.09,-.14),Vector3(.07,.03,.28),BODY.darkened(.08),Vector3.ZERO,.6)
	S.rbox(root,Vector3(.044,.04,-.1),Vector3(.006,.045,.1),DARK,Vector3.ZERO,.9)
	S.rbox(root,Vector3(0,.035,-.36),Vector3(.08,.09,.18),accent)
	vents(root,Vector3(0,.035,-.3),4,.035,.041);vents(root,Vector3(0,.035,-.3),4,.035,-.041)
	rail(root,Vector3(0,.115,-.18),.34)
	S.cyl(root,Vector3(0,.04,-.53),.02,.18,DARK,Z)
	S.cyl(root,Vector3(0,.04,-.63),.03,.06,MID,Z)
	for x in [-.018,.018]:S.rbox(root,Vector3(x,.04,-.63),Vector3(.006,.03,.03),DARK,Vector3.ZERO,.9)
	S.rbox(root,Vector3(0,.115,-.46),Vector3(.012,.04,.015),DARK,Vector3.ZERO,.8)
	S.rbox(root,Vector3(0,-.06,-.17),Vector3(.055,.12,.07),accent.darkened(.15),Vector3(-.15,0,0),.4)
	S.rbox(root,Vector3(0,-.135,-.185),Vector3(.054,.08,.068),accent.darkened(.15),Vector3(-.32,0,0),.4)
	S.rbox(root,Vector3(0,-.18,-.2),Vector3(.06,.022,.074),DARK,Vector3(-.32,0,0),.8)
	grip(root,Vector3(0,-.07,-.01))
	S.rbox(root,Vector3(0,.02,.11),Vector3(.06,.09,.16),MID)
	S.rbox(root,Vector3(0,.075,.1),Vector3(.05,.03,.12),DARK,Vector3.ZERO,.6)
	S.rbox(root,Vector3(0,.0,.2),Vector3(.07,.13,.03),DARK,Vector3.ZERO,.6)
	optic(root,Vector3(0,.165,-.14),.12,.028,accent)
	S.rbox(root,Vector3(.048,.08,-.05),Vector3(.02,.015,.03),METAL,Vector3.ZERO,.8)
	S.ell(root,Vector3(.046,.02,-.24),Vector3(.012,.03,.06),GLOW)
static func shotgun(root:Node3D,accent:Color):
	S.rbox(root,Vector3(0,.04,-.1),Vector3(.1,.13,.26),BODY)
	S.cyl(root,Vector3(0,.075,-.4),.042,.34,DARK,Z)
	S.cyl(root,Vector3(0,.075,-.585),.05,.035,accent,Z)
	for i in range(4):S.cyl(root,Vector3(0,.075,-.27-i*.07),.046,.012,MID,Z)
	S.cyl(root,Vector3(0,.005,-.35),.036,.28,MID,Z)
	S.rbox(root,Vector3(0,.0,-.35),Vector3(.085,.08,.15),accent,Vector3.ZERO,.6)
	for i in range(4):S.rbox(root,Vector3(0,-.042,-.3-i*.033),Vector3(.086,.01,.012),accent.darkened(.3),Vector3.ZERO,.9)
	for i in range(4):S.cyl(root,Vector3(.052,.04,-.03-i*.045),.014,.012,Color("e04b5a"),Vector3(0,0,PI/2))
	S.rbox(root,Vector3(0,.115,-.1),Vector3(.03,.02,.2),DARK,Vector3.ZERO,.6)
	S.ell(root,Vector3(0,.13,-.2),Vector3(.02,.02,.02),GLOW)
	grip(root,Vector3(0,-.075,.01))
	S.rbox(root,Vector3(0,.0,.13),Vector3(.075,.11,.2),accent.darkened(.35))
	S.rbox(root,Vector3(0,-.01,.235),Vector3(.08,.14,.03),DARK,Vector3.ZERO,.6)
static func sniper(root:Node3D,accent:Color):
	S.rbox(root,Vector3(0,.03,-.12),Vector3(.075,.11,.36),BODY)
	S.rbox(root,Vector3(0,.03,-.34),Vector3(.07,.08,.14),accent,Vector3.ZERO,.6)
	vents(root,Vector3(0,.03,-.3),3,.035,.036);vents(root,Vector3(0,.03,-.3),3,.035,-.036)
	S.cyl(root,Vector3(0,.04,-.66),.019,.52,DARK,Z)
	S.cyl(root,Vector3(0,.04,-.93),.032,.08,MID,Z)
	for i in range(3):S.rbox(root,Vector3(0,.04,-.91-i*.022),Vector3(.07,.012,.006),DARK,Vector3.ZERO,.9)
	optic(root,Vector3(0,.16,-.14),.3,.04,accent)
	S.cyl(root,Vector3(.055,.1,-.03),.01,.06,METAL,Vector3(0,0,PI/2))
	S.ell(root,Vector3(.085,.1,-.03),Vector3(.02,.02,.02),METAL)
	S.rbox(root,Vector3(0,-.07,-.18),Vector3(.05,.09,.06),MID,Vector3(-.2,0,0))
	grip(root,Vector3(0,-.07,-.0))
	S.rbox(root,Vector3(0,.0,.16),Vector3(.07,.12,.24),accent.darkened(.2))
	S.rbox(root,Vector3(0,.07,.14),Vector3(.05,.04,.14),MID,Vector3.ZERO,.6)
	S.rbox(root,Vector3(0,-.01,.285),Vector3(.075,.15,.03),DARK,Vector3.ZERO,.6)
	for side in [-1,1]:S.rbox(root,Vector3(side*.03,-.12,-.47),Vector3(.012,.12,.012),DARK,Vector3(0,0,side*.35),.9)
static func pistol(root:Node3D,accent:Color):
	S.rbox(root,Vector3(0,.065,-.075),Vector3(.068,.075,.2),BODY)
	S.rbox(root,Vector3(0,.02,-.065),Vector3(.062,.04,.17),DARK,Vector3.ZERO,.6)
	for i in range(4):S.rbox(root,Vector3(0,.07,.0-i*.018),Vector3(.07,.05,.006),MID,Vector3.ZERO,.9)
	S.cyl(root,Vector3(0,.072,-.19),.022,.04,accent,Z)
	S.rbox(root,Vector3(0,.108,-.16),Vector3(.012,.014,.015),DARK,Vector3.ZERO,.8)
	S.ell(root,Vector3(0,.11,.0),Vector3(.03,.012,.016),GLOW)
	S.rbox(root,Vector3(0,-.045,.01),Vector3(.055,.12,.07),accent.darkened(.2),Vector3(.3,0,0))
	S.rbox(root,Vector3(0,-.1,.03),Vector3(.058,.02,.072),DARK,Vector3(.3,0,0),.8)
	S.rbox(root,Vector3(0,-.005,-.06),Vector3(.01,.012,.05),DARK,Vector3.ZERO,.9)
static func launcher(root:Node3D,accent:Color):
	S.cyl(root,Vector3(0,.07,-.18),.075,.62,Color("6f7f47"),Z)
	for z in [-.02,-.34]:S.cyl(root,Vector3(0,.07,z),.081,.04,DARK,Z)
	S.cyl(root,Vector3(0,.07,-.5),.09,.07,accent,Z)
	S.cyl(root,Vector3(0,.07,-.535),.07,.01,DARK,Z)
	S.cyl(root,Vector3(0,.07,.14),.085,.07,accent,Z)
	S.rbox(root,Vector3(0,.16,-.2),Vector3(.03,.03,.18),DARK,Vector3.ZERO,.6)
	optic(root,Vector3(.1,.13,-.14),.12,.03,accent)
	grip(root,Vector3(0,-.05,-.05))
	S.rbox(root,Vector3(0,-.02,-.3),Vector3(.045,.1,.05),DARK,Vector3(-.2,0,0))
	for i in range(3):S.rbox(root,Vector3(-.08,.07,-.28+i*.12),Vector3(.012,.03,.06),Color("e8e2a0"),Vector3.ZERO,.9)
